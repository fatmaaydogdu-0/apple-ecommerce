<div class="container mt-5">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-0">Ürünler</h2>
    </div>

    <a
      href="/admin/product/create"
      class="btn btn-dark px-4 py-2 rounded-3 shadow-sm"
    >
      Yeni Ürün
    </a>
  </div>

  <!-- uyarı -->
  <% if (action === "edit") { %>
  <div class="alert alert-success rounded-3">Ürün güncellendi</div>
  <% } %> <% if (action === "create") { %>
  <div class="alert alert-success rounded-3">Ürün eklendi</div>
  <% } %> <% if (action === "delete") { %>
  <div class="alert alert-danger rounded-3">Ürün silindi</div>
  <% } %>

  <!-- Products -->
  <div class="row g-4">
    <% if (products && products.length > 0) { %> <% products.forEach(product =>
    { %>

    <div class="col-12 col-sm-6 col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="text-center p-3">
          <img
            src="<%= product.image %>"
            alt="<%= product.name %>"
            style="width: 100%; max-height: 180px; object-fit: contain"
          />
        </div>

        <div class="card-body pt-0">
          <h6 class="fw-bold mb-1"><%= product.name %></h6>

          <span class="large text-dark mb-1"
            >Kategori: <%= product.Category.name %>
          </span>

          <p class="small text-muted mb-1">Marka: <%= product.brand %></p>

          <p class="fw-semibold mb-3">$<%= product.price %></p>

          <div class="d-flex gap-2">
            <a
              href="/admin/product/edit/<%= product.id %>"
              class="btn btn-sm w-100 rounded-3"
            >
              Düzenle
            </a>

            <form
              action="/admin/product/delete/<%= product.id %>"
              method="POST"
              class="w-100"
            >
              <button
                type="submit"
                class="btn btn-sm w-100 rounded-3"
                onclick="return confirm('Ürünü silmek istediğinize emin misiniz?');"
              >
                Sil
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <% }) %> <% } %>
  </div>
</div>
