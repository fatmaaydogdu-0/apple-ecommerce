<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 rounded-4">
        <div class="card-body p-5">
          <h3 class="fw-bold mb-4">Yeni Ürün Ekle</h3>

          <form
            method="POST"
            action="/admin/product/create"
            enctype="multipart/form-data"
          >
            <div class="mb-3">
              <label class="form-label fw-semibold">Ürün İsmi</label>
              <input
                type="text"
                name="name"
                class="form-control"
                placeholder="Apple iPhone 14 Pro Max"
                required
              />
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Fiyat ($)</label>
              <input
                type="number"
                name="price"
                class="form-control"
                placeholder="199"
                required
              />
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Ürün Resmi</label>
              <input
                type="file"
                name="image"
                class="form-control"
                accept="image/*"
              />
              <small class="text-muted">
                JPG, PNG, GIF formatları desteklenir
              </small>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Marka</label>
              <input
                type="text"
                name="brand"
                class="form-control"
                placeholder="Apple"
                required
              />
            </div>

            <div class="mb-3">
              <label class="form-label">Kategori</label>
              <select name="categoryId" class="form-select" required>
                <option value="">Kategori seç</option>

                <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="d-flex gap-3">
              <button type="submit" class="btn btn-dark px-4">
                Ürünü Kaydet
              </button>
              <a href="/admin/products" class="btn btn-outline-secondary px-4">
                İptal
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
