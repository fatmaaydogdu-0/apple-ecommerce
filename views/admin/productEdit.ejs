<div class="container py-5" style="max-width: 900px">

  <!-- Header -->
  <div class="mb-4">
    <h1 class="fw-bold">Ürün Düzenle</h1>
  </div>

  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-5">

      <form
        action="/admin/product/edit/<%= product.id %>"
        method="POST"
        enctype="multipart/form-data"
        class="row g-4"
      >

        <div class="col-12">
          <label class="form-label text-muted small">Ürün Adı</label>
          <input
            type="text"
            name="name"
            class="form-control form-control-lg"
            value="<%= product.name %>"
            required
          />
        </div>

        <div class="col-md-6">
          <label class="form-label text-muted small">Fiyat</label>
          <input
            type="number"
            step="0.01"
            name="price"
            class="form-control"
            value="<%= product.price %>"
            required
          />
        </div>

        <div class="col-md-6">
          <label class="form-label text-muted small">Marka</label>
          <input
            type="text"
            name="brand"
            class="form-control"
            value="<%= product.brand || '' %>"
            required
          />
        </div>

        <div class="col-12">
          <label class="form-label text-muted small">Kategori</label>
          <select name="categoryId" class="form-select" required>
            <% categories.forEach(cat => { %>
              <option
                value="<%= cat.id %>"
                <%= product.categoryId === cat.id ? "selected" : "" %>
              >
                <%= cat.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-12">
          <label class="form-label text-muted small">Ürün Görseli</label>

          <% if (product.image) { %>
          <div class="mb-3">
            <img
              src="<%= product.image %>"
              alt="<%= product.name %>"
              class="border rounded-3 p-2"
              style="max-width: 180px; background:#fafafa"
            />
          </div>
          <% } %>

          <input type="file" name="image" class="form-control" accept="image/*" />

          <div class="form-text">
            Yeni görsel seçmezsen mevcut görsel korunur.
          </div>
        </div>

        <div class="col-12 d-flex justify-content-end gap-3 mt-4">
          <a href="/admin/products" class="btn btn-light px-4">
            İptal
          </a>

          <button type="submit" class="btn btn-dark px-4">
            Kaydet
          </button>
        </div>

      </form>
    </div>
  </div>
</div>