<div class="container py-5">
  <div class="row">
    <div class="col-12">
      <h4 class="fw-bold mb-2">
        <% if (searchQuery) { %> "<%= searchQuery %>" için arama sonuçları <% }
        else { %> Arama Sonuçları <% } %>
      </h4>

      <div class="row g-4">
        <% if (products && products.length > 0) { %> <% for (let i = 0; i <
        products.length; i++) { %> <%- include('../partials/product-card', {
        product: products[i], colClass: 'col-6 col-lg-4' }) %> <% } %> <% } else
        { %>
        <div class="col-12 text-center py-5">
          <p class="text-muted fs-5">Sonuç bulunamadı.</p>

          <a href="/products" class="btn btn-dark mt-3"> Tüm Ürünlere Dön </a>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
