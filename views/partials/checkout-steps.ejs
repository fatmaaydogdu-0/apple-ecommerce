<div class="container-fluid py-4">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center">
      <!-- STEP 1 -->
      <div class="d-flex align-items-center gap-3">
        <img
          src="/static/images/icons/Location.png"
          alt="Address"
          width="24"
          class="<%= step === 1 ? '' : 'opacity-50' %>"
        />
        <div class="<%= step === 1 ? 'fw-bold text-dark' : 'text-muted' %>">
          <div class="small">Step 1</div>
          <div>Address</div>
        </div>
      </div>

      <!-- STEP 2 -->
      <div class="d-flex align-items-center gap-3">
        <img
          src="/static/images/icons/Shipping.png"
          alt="Shipping"
          width="24"
          class="<%= step === 2 ? '' : 'opacity-50' %>"
        />
        <div class="<%= step === 2 ? 'fw-bold text-dark' : 'text-muted' %>">
          <div class="small">Step 2</div>
          <div>Shipping</div>
        </div>
      </div>

      <!-- STEP 3 -->
      <div class="d-flex align-items-center gap-3">
        <img
          src="/static/images/icons/Payment.png"
          alt="Payment"
          width="24"
          class="<%= step === 3 ? '' : 'opacity-50' %>"
        />
        <div class="<%= step === 3 ? 'fw-bold text-dark' : 'text-muted' %>">
          <div class="small">Step 3</div>
          <div>Payment</div>
        </div>
      </div>
    </div>
  </div>
</div>
