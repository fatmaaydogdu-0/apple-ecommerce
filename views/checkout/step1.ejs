<%- include('../partials/checkout-steps', { step: 1 }) %>

<div class="container checkout-step-wrap">
  <h3 class="mt-4 mb-0">Select Address</h3>

  <div class="m-4">
    <div
      class="d-flex justify-content-between align-items-start bg-light rounded px-4 py-3 mb-3 mx-auto"
    >
      <label class="d-flex gap-3 m-0 w-100" style="cursor: pointer">
        <input type="radio" name="address" checked class="mt-1" />

        <div>
          <div class="d-flex align-items-center gap-2 mb-1">
            <strong>2118 Thornridge</strong>
            <span class="badge bg-dark">Home</span>
          </div>

          <div class="text-muted small">
            2118 Thornridge Cir. Syracuse, Connecticut 35624
          </div>
          <div class="text-muted small">(209) 555-0104</div>
        </div>
      </label>

      <div class="d-flex gap-2">
        <button
          class="btn btn-sm btn-light rounded-circle d-flex align-items-center justify-content-center"
          title="Düzenle"
          style="width: 32px; height: 32px"
        >
          <img
            src="/static/images/icons/To edit.png"
            alt="Edit"
            width="14"
            height="14"
          />
        </button>
        <button class="btn btn-sm btn-light rounded-circle">✕</button>
      </div>
    </div>

    <div
      class="d-flex justify-content-between align-items-start p-3 rounded bg-light mb-3"
    >
      <label class="d-flex gap-3 m-0 w-100" style="cursor: pointer">
        <input type="radio" name="address" class="mt-1" />

        <div>
          <div class="d-flex align-items-center gap-2 mb-1">
            <strong>Headoffice</strong>
            <span class="badge bg-dark">Office</span>
          </div>

          <div class="text-muted small">
            2715 Ash Dr. San Jose, South Dakota 83475
          </div>
          <div class="text-muted small">(704) 555-0127</div>
        </div>
      </label>

      <div class="d-flex gap-2">
        <button
          class="btn btn-sm btn-light rounded-circle d-flex align-items-center justify-content-center"
          title="Düzenle"
          style="width: 32px; height: 32px"
        >
          <img
            src="/static/images/icons/To edit.png"
            alt="Edit"
            width="14"
            height="14"
          />
        </button>
        <button class="btn btn-sm btn-light rounded-circle">✕</button>
      </div>
    </div>

    <button class="btn btn-link d-flex align-items-center">
      <img src="/static/images/icons/new.png" alt="Yeni adres" class="img-fluid" />
    </button>

    <div class="d-flex justify-content-end gap-3 mt-4">
      <a href="/cart" class="btn btn-light px-5">Back</a>
      <a href="/checkout/step2" class="btn btn-dark px-5">Next</a>
    </div>
  </div>
</div>
